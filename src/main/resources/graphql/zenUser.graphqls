 type zenUser {
     id: ID!
     username: String!
     email: String!
     createdAt: String!
     timeZone: String!
}

 input SignUpInput {
    username: String!
     email: String!
     password: String!
     timeZone: String!
 }

 input UpdateUserInput {
     username: String
     email: String
     password: String
     timeZone: String
 }

 input DeleteUserInput {
     id: ID!
 }